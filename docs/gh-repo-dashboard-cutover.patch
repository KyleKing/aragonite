252     // A stamp cannot prove a pull request is still open, because someone else can
253     // merge it without touching this working copy. It only evicts early.
254     func TestAStampOnlyShortensARemoteValuesLife(t *testing.T) {
255         t.Parallel()
256     
257         clock := newFakeClock()
258         c := cache.NewTTLCacheWithClock[[]models.PRInfo](5*time.Minute, clock.now)
259     
260         const key = "github.com/acme/app\x00acme/app:all_prs"
261     
262         before := cache.Stamp{Scope: "/repo", Fingerprint: "unpushed"}
263         after := cache.Stamp{Scope: "/repo", Fingerprint: "pushed"}
264         peer := cache.Stamp{Scope: "/peer-checkout", Fingerprint: "its-own-head"}
265     
266         c.Set(key, before, []models.PRInfo{{Number: 1}})
267     
268         if _, ok := c.Get(key, before); !ok {
269             t.Error("an unchanged checkout refetched the PR list inside the TTL")
270         }
271         if _, ok := c.Get(key, peer); !ok {
272             t.Error("a second checkout of the same remote refetched the PR list")
273         }
274         if _, ok := c.Get(key, after); ok {
275             t.Error("a push left the PR list cached")
276         }
277     
278         c.Set(key, after, []models.PRInfo{{Number: 2}})
279         clock.advance(6 * time.Minute)
280     
281         if _, ok := c.Get(key, after); ok {
282             t.Error("an unchanged stamp carried the PR list past its TTL")
283         }
284     }
