222 // load reads upstream's file, dropping one this build cannot trust. The caller
223 // holds d.mu.
224 func (d *DiskCache) load(upstream string) (diskFile, bool) {
225     path := d.path(upstream)
226 
227     data, err := os.ReadFile(path) //nolint:gosec // a hashed name under the store's own directory
228     if err != nil {
229         return diskFile{}, false
230     }
231 
232     var file diskFile
233     if err := json.Unmarshal(data, &file); err != nil ||
234         file.Version != diskSchemaVersion || file.Upstream != upstream {
235         removeQuietly(path)
236 
237         return diskFile{}, false
238     }
239 
240     if file.Entries == nil {
241         file.Entries = map[string]diskEntry{}
242     }
243 
244     return file, true
245 }
246 
247 func (d *DiskCache) save(upstream string, file diskFile) error {
248     if err := d.ensureDir(); err != nil {
249         return err
250     }
251 
252     data, err := json.Marshal(file)
253     if err != nil {
254         return fmt.Errorf("encoding the cache for %s: %w", upstream, err)
255     }
256 
257     return writeAtomic(d.dir, d.path(upstream), data)
258 }
259 
260 // writeAtomic publishes data by renaming a temp file from the same directory,
261 // so a reader sees either the old file or the whole new one however many
262 // sessions write at once. The mode is set before the rename, never after, so
263 // the contents are never readable at the temp file's own mode.
264 func writeAtomic(dir, path string, data []byte) error {
265     tmp, err := os.CreateTemp(dir, "tmp-*")
266     if err != nil {
267         return fmt.Errorf("creating a temporary cache file in %s: %w", dir, err)
268     }
269 
270     name := tmp.Name()
271 
272     if err := fillFile(tmp, data); err != nil {
273         removeQuietly(name)
274 
275         return err
276     }
277 
278     if err := os.Rename(name, path); err != nil {
279         removeQuietly(name)
280 
281         return fmt.Errorf("replacing %s: %w", path, err)
282     }
283 
284     return nil
285 }
286 
287 func fillFile(file *os.File, data []byte) error {
288     if err := file.Chmod(diskFileMode); err != nil {
289         closeQuietly(file)
290 
291         return fmt.Errorf("securing %s: %w", file.Name(), err)
292     }
293 
294     if _, err := file.Write(data); err != nil {
295         closeQuietly(file)
296 
297         return fmt.Errorf("writing %s: %w", file.Name(), err)
298     }
299 
300     if err := file.Close(); err != nil {
301         return fmt.Errorf("closing %s: %w", file.Name(), err)
302     }
303 
304     return nil
305 }
306 
307 func closeQuietly(file *os.File) {
308     _ = file.Close() //nolint:errcheck // the caller is already returning the failure that matters
309 }
310 
311 func (d *DiskCache) ensureDir() error {
312     if err := os.MkdirAll(d.dir, diskDirMode); err != nil {
313         return fmt.Errorf("creating %s: %w", d.dir, err)
314     }
315 
316     // MkdirAll leaves an existing directory's mode alone, and a cache directory
317     // inherited from an earlier, wider umask must not stay group-readable.
318     if err := os.Chmod(d.dir, diskDirMode); err != nil {
319         return fmt.Errorf("securing %s: %w", d.dir, err)
320     }
321 
322     return nil
323 }
324 
325 func (d *DiskCache) path(upstream string) string {
326     sum := sha256.Sum256([]byte(upstream))
327 
328     return filepath.Join(d.dir, hex.EncodeToString(sum[:])+diskFileSuffix)
329 }
330 
331 // touch records that the file was used, so eviction orders by last read rather
332 // than by last write.
333 func (d *DiskCache) touch(upstream string) {
334     now := time.Now()
335     //nolint:errcheck // an unrecorded read costs eviction order, nothing a caller can act on
336     _ = os.Chtimes(d.path(upstream), now, now)
337 }
338 
339 type diskFileInfo struct {
340     path string
341     size int64
342     used time.Time
343 }
344 
345 // evict trims the store to its byte budget, least recently used first, so a
346 // fleet scanned once does not keep its cache forever.
347 func (d *DiskCache) evict() {
348     files := d.stat()
349 
350     total := sumSizes(files)
351     if total <= d.maxBytes {
352         return
353     }
354 
355     slices.SortFunc(files, func(a, b diskFileInfo) int { return a.used.Compare(b.used) })
356 
357     for _, f := range files {
358         if total <= d.maxBytes {
359             return
360         }
361 
362         removeQuietly(f.path)
363         total -= f.size
364     }
365 }
366 
367 // stat returns every cache file with its size and last use. Temp files are
368 // skipped: one belongs to a write still in flight, here or in another session.
369 func (d *DiskCache) stat() []diskFileInfo {
370     dirEntries, err := os.ReadDir(d.dir)
371     if err != nil {
372         return nil
373     }
374 
375     var files []diskFileInfo
376 
377     for _, dirEntry := range dirEntries {
378         if dirEntry.IsDir() || filepath.Ext(dirEntry.Name()) != diskFileSuffix {
379             continue
380         }
381 
382         info, err := dirEntry.Info()
383         if err != nil {
384             continue
385         }
386 
387         files = append(files, diskFileInfo{
388             path: filepath.Join(d.dir, dirEntry.Name()),
389             size: info.Size(),
390             used: info.ModTime(),
391         })
392     }
393 
394     return files
395 }
396 
397 func sumSizes(files []diskFileInfo) int64 {
398     var total int64
399     for _, f := range files {
400         total += f.size
401     }
402 
403     return total
404 }
405 
406 func removeQuietly(path string) {
407     _ = os.Remove(path) //nolint:errcheck // a file the store cannot delete is a file it stops reading
408 }
