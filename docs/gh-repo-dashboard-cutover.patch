286     // A checkout that read the entry earlier is the one a later change evicts it
287     // for; a checkout meeting the entry for the first time is a new reader, not a
288     // local change, and must not throw away what its peers just paid for.
289     func TestOneCheckoutsChangeDoesNotEvictForAnother(t *testing.T) {
290         t.Parallel()
291     
292         c := cache.NewTTLCache[int](5 * time.Minute)
293         const key = "shared"
294     
295         c.Set(key, cache.Stamp{Scope: "/a", Fingerprint: "a1"}, 7)
296     
297         if _, ok := c.Get(key, cache.Stamp{Scope: "/b", Fingerprint: "b1"}); !ok {
298             t.Fatal("a first-time reader was treated as a changed checkout")
299         }
300         if _, ok := c.Get(key, cache.Stamp{Scope: "/b", Fingerprint: "b2"}); ok {
301             t.Error("the reader's own later change did not evict")
302         }
303     }

