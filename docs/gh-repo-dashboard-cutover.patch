 15 // diskSchemaVersion guards the shape of what is written. Bump it whenever a
 16 // persisted struct gains, loses, or renames a field: a file written under
 17 // another version is dropped rather than decoded into zero values.
 18 const diskSchemaVersion = 1
 19 
 20 const (
 21     diskFileMode   = 0o600
 22     diskDirMode    = 0o700
 23     diskMaxBytes   = 4 << 20
 24     diskFileSuffix = ".json"
 25 )
 26 
 27 // DiskCache persists remote-derived cache values between runs, one file per
 28 // upstream identity, so a cold start on a large fleet does not re-issue a
 29 // network call per repo. It holds only counts, states, numbers, and titles
 30 // (never bodies or comment text) in mode 0600 files under a 0700 directory.
 31 // A corrupt, truncated, or unreadable file is dropped and refetched, never
 32 // reported as an error.
 33 type DiskCache struct {
 34     mu       sync.Mutex
 35     dir      string
 36     maxBytes int64
 37 }
 38 
 39 // NewDiskCache returns a store writing under dir, which is created on first
 40 // write.
 41 func NewDiskCache(dir string) *DiskCache {
 42     return &DiskCache{dir: dir, maxBytes: diskMaxBytes}
 43 }
 44 
 45 // UserDiskCache returns the store under os.UserCacheDir(), which is where a
 46 // cache belongs on every platform the app builds for.
 47 func UserDiskCache() (*DiskCache, error) {
 48     base, err := os.UserCacheDir()
 49     if err != nil {
 50         return nil, fmt.Errorf("resolving the user cache directory: %w", err)
 51     }
 52 
 53     return NewDiskCache(filepath.Join(base, "gh-repo-dashboard")), nil
 54 }
 55 
 56 //nolint:gochecknoglobals // the installed store, like the caches it backs
 57 var (
 58     diskMu    sync.RWMutex
 59     diskStore *DiskCache
 60 )
 61 
 62 // SetDiskCache installs the store Persist writes through and Persisted reads
 63 // back. Nothing is installed until a caller opts in, so a `cache_to_disk =
 64 // false` run (and every test) touches no files at all.
 65 func SetDiskCache(store *DiskCache) {
 66     diskMu.Lock()
 67     defer diskMu.Unlock()
 68 
 69     diskStore = store
 70 }
 71 
 72 func installedDiskCache() *DiskCache {
 73     diskMu.RLock()
 74     defer diskMu.RUnlock()
 75 
 76     return diskStore
 77 }
 78 
 79 // diskFile is one upstream's whole cache. The version and the upstream are read
 80 // back before the entries, so a file from another schema or another key is
 81 // dropped instead of decoded.
 82 type diskFile struct {
 83     Version  int                  `json:"version"`
 84     Upstream string               `json:"upstream"`
 85     Entries  map[string]diskEntry `json:"entries"`
 86 }
 87 
 88 type diskEntry struct {
 89     Value     json.RawMessage   `json:"value"`
 90     ExpiresAt time.Time         `json:"expires_at"`
 91     Seen      map[string]string `json:"seen"`
 92 }
 93 
 94 // Persisted returns the value for key, reading the upstream's cache file when
 95 // the memory cache misses and seeding memory from what it finds. The file is
 96 // read on the miss that needs it rather than at startup, so landing on one row
 97 // costs one small read instead of one per repo on the roster.
 98 //
 99 // The disk entry keeps its own expiry and the fingerprints it was written
100 // under, so reading it back neither restarts the TTL nor loses the stamp rule.
101 //
102 //nolint:ireturn // T is the cache's own type parameter, not an abstraction leak
103 func Persisted[T any](c *TTLCache[T], upstream, key string, stamp Stamp) (T, bool) {
104     return persistedFrom(installedDiskCache(), c, upstream, key, stamp)
105 }
106 
107 //nolint:ireturn // T is the cache's own type parameter, not an abstraction leak
108 func persistedFrom[T any](d *DiskCache, c *TTLCache[T], upstream, key string, stamp Stamp) (T, bool) {
109     if value, ok := c.Get(key, stamp); ok {
110         return value, true
111     }
112 
113     var zero T
114 
115     if d == nil || upstream == "" {
116         return zero, false
117     }
118 
119     e, ok := d.read(upstream, key, stamp, c.clock())
120     if !ok {
121         return zero, false
122     }
123 
124     var value T
125     if err := json.Unmarshal(e.Value, &value); err != nil {
126         return zero, false
127     }
128 
129     c.restore(key, value, e.ExpiresAt, e.Seen, stamp)
130 
131     return value, true
132 }
133 
134 // Persist stores value in c and, when a store is installed, in upstream's cache
135 // file. An empty upstream is memory-only: a checkout with no resolvable remote
136 // shares its values with nobody, and a file per path is the unbounded growth
137 // the size budget exists to prevent.
138 func Persist[T any](c *TTLCache[T], upstream, key string, stamp Stamp, value T) {
139     persistTo(installedDiskCache(), c, upstream, key, stamp, value)
140 }
141 
142 func persistTo[T any](d *DiskCache, c *TTLCache[T], upstream, key string, stamp Stamp, value T) {
143     c.Set(key, stamp, value)
144 
145     if d == nil || upstream == "" {
146         return
147     }
148 
149     encoded, err := json.Marshal(value)
150     if err != nil {
151         return
152     }
153 
154     seen := make(map[string]string, 1)
155     if stamp.Fingerprint != "" {
156         seen[stamp.Scope] = stamp.Fingerprint
157     }
158 
159     d.write(upstream, key, diskEntry{Value: encoded, ExpiresAt: c.deadline(), Seen: seen}, c.clock())
160 }
161 
162 func (d *DiskCache) read(upstream, key string, stamp Stamp, now time.Time) (diskEntry, bool) {
163     d.mu.Lock()
164     defer d.mu.Unlock()
165 
166     file, ok := d.load(upstream)
167     if !ok {
168         return diskEntry{}, false
169     }
170 
171     e, ok := file.Entries[key]
172     if !ok || now.After(e.ExpiresAt) {
173         return diskEntry{}, false
174     }
175 
176     if prev, recorded := e.Seen[stamp.Scope]; recorded && stamp.Fingerprint != "" && prev != stamp.Fingerprint {
177         return diskEntry{}, false
178     }
179 
180     d.touch(upstream)
181 
182     return e, true
183 }
184 
185 func (d *DiskCache) write(upstream, key string, e diskEntry, now time.Time) {
186     d.mu.Lock()
187     defer d.mu.Unlock()
188 
189     file, ok := d.load(upstream)
190     if !ok {
191         file = diskFile{Version: diskSchemaVersion, Upstream: upstream, Entries: map[string]diskEntry{}}
192     }
193 
194     for existing, held := range file.Entries {
195         if now.After(held.ExpiresAt) {
196             delete(file.Entries, existing)
197         }
198     }
199 
200     file.Entries[key] = e
201 
202     if err := d.save(upstream, file); err != nil {
203         return
204     }
205 
206     d.evict()
207 }
208 
209 // Clear removes every cache file, leaving the directory in place. Refresh drops
210 // the disk copy along with the memory one: it is pressed because something
211 // looks wrong, and a refresh that leaves a stale pull request state behind
212 // cannot fix it.
213 func (d *DiskCache) Clear() {
214     d.mu.Lock()
215     defer d.mu.Unlock()
216 
217     for _, f := range d.stat() {
218         removeQuietly(f.path)
219     }
220 }
